// Jewler function
//
// Keywords:
// job, jewel, gem, emerald, sapphire, ruby, rubies, citrine, amethyst, tourmaline, amber, diamond, necklace, bracelet, earring, ring, bead, gold, silver

//
//
// 
// - cwm


#Fragment Britannia, Job, Britannia_Jeweler {
#Sophistication High {
#Key "*job*", "*work*", "*what*do*do*", "*profession*", "*occupation*" {
#Attitude Wicked {
"I'm a jeweler.",
"I make jewelry."
		}
#Attitude Neutral {
"I'm the jeweler.",
"Can I interest thee in some lovely jewelry?"
		}
#Attitude Goodhearted {
"I'm a maker of fine jewelry.",
"I sell only the finest jewelry."
		}
		}
#KEY "*skill*" "*appraise*" "*value*" "*quality*" "*estimate*"  {
	#Attitude Wicked {
	"¿Para qué usarías las habilidades que podría enseñarte? Mal uso, apostaría.",
"Podrías aprender algunas cosas de mí, si pudieras convencerme de que te enseñe. Aunque eso es improbable.",
"Podría enseñarte el valor de las joyas y cómo saber por ti mismo lo que valen. Podría ser, um, persuadido para mostrarte una o dos cosas."
			}
	#Attitude Neutral {
	"Si quieres aprender, podría persuadirte para que te enseñe algunas habilidades de tasación. Tendrías que pagarme, por supuesto.",
"Algunas cosas que sé podrían serte de utilidad, si valoras las joyas. Creo que podría ayudarte un poco.",
"Si necesitas ayuda con algo que yo sepa, como saber el valor de las joyas, solo pídeme que te enseñe y lo haré. Por un módico precio.",
"Puedo enseñarte algunas cosas sobre la calidad de las joyas."
			}
	#Attitude Goodhearted {
	"Claro, podría enseñarte algunas cosas sobre las joyas. Por un pequeño costo para tu bolsa.",
"Siempre puedes aprender cosas nuevas, amigo mío. Podría mostrarte algunas cosas sobre la calidad de las joyas que podrían ayudarte. Por una pequeña cantidad de dinero, por supuesto.",
"Puedo enseñarte algunas de las claves de las tasaciones. Sin embargo, necesitaría que me pagaras por mi tiempo."
			}
		}
#KEY "*jewel*" {
#Attitude Wicked {
"I sell jewelry of all types.",
"I will sell thee new jewelry or buy thy gems and jewels."
		}
#Attitude Neutral {
"My jewelry is most eye-catching.",
"My jewelry is the perfect gift for a loved one."
		}
#Attitude Goodhearted {              
"My jewelry is highly praised by many noble customers.",
"My jewelry will greatly enhance the appearance of any lady or gentleman."
		}
		}
#KEY "*gem*", "*emerald*", "*sapphire*", "*ruby*", "*rubies*", "*citrine*", "*amethyst*", "*tourmaline*", "*amber*", "*diamond*", "*gold*", "*silver*" {
#Attitude Wicked {
		"I might be interested in purchasing loose gems or precious metals.",
		"I'm looking for gold, silver, emeralds, sapphires, star sapphires, rubies, citrines, amethysts, tourmalines, amber or diamonds."
		}
#Attitude Neutral {
		"If thou hast any gold, silver or loose gems, I might be interested in taking them off thy hands.",
		"I'll buy gold, silver, emeralds, sapphires, star sapphires, rubies, citrines, amethysts, tourmalines, amber or diamonds."
		}
#Attitude Goodhearted {
		"I should be eager to see any gold, silver, or loose gems thou might have for sale.",
		"I have need of gold and silver, emeralds, sapphires, star sapphires, rubies, citrines, amethysts, tourmalines, amber and diamonds."
		}
		}
#KEY "*necklace*", "*bracelet*", "*ring*", "*bead*" {
#Attitude Wicked {
		"I sell necklaces, bracelets, earrings, rings or beads."
		}
#Attitude Neutral {	
		"I sell necklaces, bracelets, earrings, rings or beads."
		}
#Attitude Goodhearted {
		"I'll buy or sell necklaces, bracelets, earrings, rings or beads."
		}
}
}
