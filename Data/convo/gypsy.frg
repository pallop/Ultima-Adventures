// Gypsy function
//
// Keywords:
// job, gypsy, thief, steal
//
// leash, wanderer, fortune?
// 
// - cwm


#Fragment Britannia, Job, Britannia_Gypsy {

#Sophistication High {
#Key "*job*", "*work*", "*what*do*do*", "*profession*", "*occupation*" {
#Attitude Wicked {
	"I have no leash around my neck.  I am a freeman!",
	"Others can have their 'jobs.' I choose the open road."
	}
#Attitude Neutral {
	"I'm a child of the open road.  I wander freely of my own accord.",
	"I'm a wanderer, and take whatever fortune offers me."
	}
#Attitude Goodhearted {
	"I'm a freeman, and my job is to be who I am and ask nothing more from anyone else.",
	"I am contented wandering as my fortune may carry me."
	}
	}
#KEY "*skill*" "*lock*" "*appraise*" "*hide*" "*camp*"  {
	#Attitude Wicked {
	"Aléjate de mí. No tengo ninguna razón para mostrarte nada que pueda ayudarte, aunque sé bastante",
"¡No necesito mostrarte nada! ¡No eres un hombre libre!",
"¡Oh sí, sé muchas cosas! Cosas que podrían ayudarte en tus viajes. Cosas que no me apetece mostrarte."
			}
	#Attitude Neutral {
	"Si quieres aprender, podría persuadirte para que te enseñe cosas como acampar en la naturaleza. O a no ser visto cuando NO QUIERES ser visto. Tendrías que pagarme, ya sabes.",
"Deberías saber algo sobre la gente con la que es probable que pases tiempo. Podría serte de utilidad. Creo que podría ayudarte un poco.",
"Si necesitas ayuda con tus habilidades para acampar, solo pídeme que te enseñe y si puedo, lo haré. Por un módico precio.",
"Puedo enseñarte a observar mejor las cosas que te rodean. Cosas como la gente que ves todos los días."
			}
	#Attitude Goodhearted {
	"Me alegraría que aprendieras lo que sé sobre sobrevivir en las ciudades. Solo dame unas pocas monedas.",
"Siempre puedes aprender cosas nuevas, amigo mío. Podría mostrarte algunas cosas, por ejemplo, sobre la observación de la gente que podrían ayudarte. Por una pequeña cantidad de dinero, por supuesto.",
"Puedo enseñarte cosas que podrían ayudarte cuando acampes. Sin embargo, necesitaría que me pagaras por mi tiempo."
			}
		}
#KEY "*gypsy*" "*freeman*" "*gypsie*" {
#Attitude Wicked {
	"Dost thou have a problem with us?  Live and let live, I say.",
	"What's wrong with 'gypsies,' as thou dost call us?  We are honest people who choose to live where we feel most comfortable at the moment."
	}
#Attitude Neutral {
	"I am a true freeman, born and bred.",
	"Not everyone is lucky enough to be born a freeman. Thou might refer to us as  gypsies, nevertheless we are a breed apart."
	}
#Attitude Goodhearted {
	"We freemen, or 'gypsies,' as thy people insist on calling us, are brothers to the road!",
	"Music, love and travel, that is the life of a freeman!"
}
}
#KEY "*thief*" "*steal*" "*thiev*" {
#Attitude Wicked {
	"I refuse to answer to any base accusations!",
	"Thou cannot prove anything!"
		}
#Attitude Neutral {
	"A thief? I see thou hast been listening to malicious lies about us... 'gypsies,' to use thy own word.",
	"Freemen are not thieves! That is a malicious lie of the ignorant."
		}
#Attitude Goodhearted {
	"We have no need to steal, for nature meets all our needs.",
	"What could I possibly steal? I have everything I need!"
}
}
}
#Sophistication Medium {
#Key "*job*", "*work*", "*what*do*do*", "*profession*", "*occupation*" {
#Attitude Wicked {
