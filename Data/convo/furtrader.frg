			}
		}
#KEY "*food*", "*hungry*", "*bread*", "*pie*", "*cake*", "*muffin*", "*cheese*", "*bird*", "*ribs*", "*mutton*", "*chicken*", "*carrots*", "*corn*", "*lettuce*", "*peas*", "*potatoes*", "*stew*", "*soup*" {
#Attitude Wicked {
		"Yeah, I'll buy some.",
		"If thou'rt offerin', I'm buyin'."
