// Fur Trader function
//
// Keywords:
// job, fur, skin, fleece, wool, food, hungry, bread, pie, cake, muffin, cheese, bird, ribs, mutton, chicken, carrots, corn, lettuce, peas, potatoes, stew, soup
//
//
// 
// - mmt


#Fragment Britannia, Job, Britannia_fur_trader {
#Sophistication High {
#KEY "*job*" "*what*do*do*" "*work*" "*profession*" "*occupation*" { 
#Attitude Wicked {
"I sell furs and fleece.",
"Thou dost want furs, I'll sell 'em to thee."
		}
#Attitude Neutral {
"Skins, furs, fleece ... if it comes off the back of a creature, I'll sell it to thee.",
"My trade is selling pelts of all sorts."
		}
#Attitude Goodhearted {
"'Tis a free life for me, tho' I use fur trading as an excuse to stay free of the cities.",
"I sell furs and meet interesting people, mostly. Pleased to know thee."
		}
}
#KEY "*skin*" "*fleece*" "*wool*" "*pelt*" {
#Attitude Wicked {
"Thou dost want some? I've got some.",
"I sell furs, and  it ain't bad for whence they came."
		}
#Attitude Neutral {
"Weather's turning chill. Thou'll be wantin' warm furs.",
"My furs'll warm thy back, thy bedroll and thy whole outlook on life."
		}
#Attitude Goodhearted {
"Warm in body, warm in heart, thou knowest. Buy an extra one and thou wilt have a pillow finer than a king's.",
"I can tell by the look in thine eye that thou hast spent too long sleeping on twigs and rocks. I can sell thee warm days and soft nights."
		}
		}
#KEY "*skill*" "*critter*" "*animal*" "*camp*" "*creature*"  {
	#Attitude Wicked {
	"Puedo enseñarte algunas cosas sobre los animales. Podría ayudarte cuando estés en la naturaleza.",
"Deberías saber algo sobre las criaturas con las que es probable que pases tiempo al aire libre. Podría serte de utilidad.",
"Podría enseñarte a conocer a las criaturas del bosque. Y podrías aprender un poco sobre acampar de mí. Sé cosas que podrían ayudarte, de verdad."
			}
	#Attitude Neutral {
	"Si quieres aprender, podría persuadirte para que te enseñe a acampar en la naturaleza.",
"Si necesitas ayuda con tus habilidades para acampar, solo pídeme que te enseñe y si puedo, lo haré.",
"Puedo enseñarte sobre los animales del bosque y cómo saber más sobre ellos, si estás dispuesto."
			}
	#Attitude Goodhearted {
	"Me alegraría que aprendieras lo que sé sobre sobrevivir en la naturaleza.",
"Siempre puedes aprender cosas nuevas, amigo mío. Podría mostrarte algunas cosas, por ejemplo, sobre la naturaleza que podrían ayudarte.",
"Puedo enseñarte cosas que podrían ayudarte en la naturaleza. Sin embargo, necesitaría que me pagaras por mi tiempo."
			}
		}
#KEY "*food*", "*hungry*", "*bread*", "*pie*", "*cake*", "*muffin*", "*cheese*", "*bird*", "*ribs*", "*mutton*", "*chicken*", "*carrots*", "*corn*", "*lettuce*", "*peas*", "*potatoes*", "*stew*", "*soup*" {
#Attitude Wicked {
		"Yes, I'll buy some.",
		"If thou art offerin', I'm buyin'."
		}
#Attitude Neutral {
"I've had naught but dried meat and berries for a week. I'll buy what thou art offering.",
"Fresh food would be a godsend ... and I'm not picky."
		}
#Attitude Goodhearted {
"Ah, now thou'rt a good friend, to bring the market to the meadows!",
"I will admit, 'tis a hungryin' life, to walk the wilds between towns."
		}
		}
}
#Sophistication Medium {
#KEY "*job*" "*what*do*do*" "*work*" "*profession*" "*occupation*" { 
#Attitude Wicked {
"I sell furs and fleece.",
"Thou want furs, I'll sell 'em to thee."
		}
#Attitude Neutral {
"Skins, furs, fleece ... if'n it come off t' back of a critter, I'll sell it to thee.",
"Me trade is selling pelts of all sorts."
		}
#Attitude Goodhearted {
"It's a free life for me, tho' I use fur trading as an excuse to stay free of t' cities.",
"I sell furs and meet interestin' people, mostly. Pleased ta know thee."
		}
}
